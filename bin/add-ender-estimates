#!/usr/bin/env python3

BOTTOM_LINES_ANALYZED_COUNT: int = 400
BOTTOM_LINES_EXCLUDED_COUNT: int = 150


def parse_time(components: list[tuple[str, str]]) -> int:
    lookup: dict[str, int] = {
        "d": 86400,
        "h": 3600,
        "m": 60,
        "s": 1,
    }

    total_seconds: int = 0

    for value, unit in components:
        total_seconds += int(value) * lookup[unit]

    return total_seconds


if __name__ == "__main__":
    import os
    import re
    import sys

    header: list[str] = [";FLAVOR:Marlin\n"]
    gcode_path: str = sys.argv[1]

    stat: str = os.stat(gcode_path)
    original_timestamp: str = (stat.st_atime, stat.st_mtime)
    lines: list[str]

    with open(gcode_path, "r") as f:
        lines = f.readlines()

    prusa_settings_lines: str = "".join(
            lines[-BOTTOM_LINES_ANALYZED_COUNT:
                  -BOTTOM_LINES_EXCLUDED_COUNT])

    prusa_time_estimated: str = re.search(
            r"; estimated printing time \(.+?\) = (.*)",
            prusa_settings_lines)[1]

    time_components: list[str] = re.findall(
            r"(\d+)([dhms])", prusa_time_estimated)

    total_seconds: int = parse_time(time_components)
    header.append(f";TIME:{total_seconds}\n")

    prusa_filament_used_mm: str = re.search(
            r"; filament used \[mm\] = (\d+\.\d+)",
            prusa_settings_lines)[1]

    prusa_filament_used_m: float = float(prusa_filament_used_mm) / 1000
    header.append(f";Filament used: {prusa_filament_used_m:.2f}m\n")

    layer_height: str = re.search(
            r"; layer_height = (\d+\.\d+)",
            prusa_settings_lines)[1]

    header.append(f";Layer height: {layer_height}\n")
    header.append(";TARGET_MACHINE.NAME:Creality Ender-3 V3 SE\n")
    header.append(f";Generated by {sys.argv[0]}\n\n")

    with open(gcode_path, "w") as f:
        f.writelines(header)
        f.writelines(lines)

    os.utime(gcode_path, original_timestamp)
